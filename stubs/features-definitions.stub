<?php

declare(strict_types=1);

namespace {{ namespace }};

/**
 * Every feature key lives here. Check them with Feature::enabled(Features::ORDERS);
 * change them only with the feature:* console commands (platform admins).
 */
final class Features
{
    public const ORDERS = 'orders';

    public const REPORTS = 'reports';

    /**
     * Every feature key and its default state (per tenant in tenant-saas, for the app in saas).
     *
     * @return array<string, bool>
     */
    public static function defaults(): array
    {
        return [
            self::ORDERS => true,
            self::REPORTS => false,
        ];
    }
}
