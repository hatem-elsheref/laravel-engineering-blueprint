it('denies guests', function (): void {
    ${{ variable }} = {{ entity }}::factory()->create();

    $this->getJson('/api/{{ uri }}')->assertForbidden();
    $this->postJson('/api/{{ uri }}', {{ entity }}::factory()->raw())->assertForbidden();
    $this->getJson("/api/{{ uri }}/{${{ variable }}->id}")->assertForbidden();
    $this->putJson("/api/{{ uri }}/{${{ variable }}->id}", {{ entity }}::factory()->raw())->assertForbidden();
    $this->deleteJson("/api/{{ uri }}/{${{ variable }}->id}")->assertForbidden();
});

it('hides which {{ uri }} exist from guests', function (): void {
    $this->getJson('/api/{{ uri }}/999999')->assertForbidden();
    $this->actingAs($this->user)->getJson('/api/{{ uri }}/999999')->assertNotFound();
});

it('lists {{ uri }}', function (): void {
    {{ entity }}::factory()->create();

    $this->actingAs($this->user)->getJson('/api/{{ uri }}')->assertOk()->assertJsonCount(1, 'data');
});

it('creates a {{ variable }}', function (): void {
    $this->actingAs($this->user)->postJson('/api/{{ uri }}', {{ entity }}::factory()->raw())->assertCreated();

    expect({{ entity }}::count())->toBe(1);
});
