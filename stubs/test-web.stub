it('shows and edits a {{ variable }}', function (): void {
    ${{ variable }} = {{ entity }}::factory()->create();

    $this->actingAs($this->user)->get({{ url }}("/{{ uri }}/{${{ variable }}->id}"))->assertOk();
    $this->actingAs($this->user)->get({{ url }}("/{{ uri }}/{${{ variable }}->id}/edit"))->assertOk();
});

it('updates a {{ variable }}', function (): void {
    ${{ variable }} = {{ entity }}::factory()->create();

    $this->actingAs($this->user)->put({{ url }}("/{{ uri }}/{${{ variable }}->id}"), {{ variable }}FormInput())
        ->assertSessionHasNoErrors()
        ->assertRedirectContains("/{{ uri }}/{${{ variable }}->id}");
});

it('deletes a {{ variable }}', function (): void {
    ${{ variable }} = {{ entity }}::factory()->create();

    $this->actingAs($this->user)->delete({{ url }}("/{{ uri }}/{${{ variable }}->id}"))->assertRedirectContains('/{{ uri }}');

    expect({{ entity }}::count())->toBe(0);
});
