function {{ variable }}FormInput(array $overrides = []): array
{
    // Factory values as a browser form would send them.
    return array_map(
        fn ($value) => $value instanceof DateTimeInterface ? $value->format('Y-m-d\TH:i') : (is_bool($value) ? (int) $value : $value),
        array_merge({{ entity }}::factory()->raw(), $overrides),
    );
}

it('denies guests', function (): void {
    ${{ variable }} = {{ entity }}::factory()->create();

    $this->get({{ url }}('/{{ uri }}'))->assertForbidden();
    $this->get({{ url }}('/{{ uri }}/create'))->assertForbidden();
    $this->post({{ url }}('/{{ uri }}'), {{ variable }}FormInput())->assertForbidden();
    $this->get({{ url }}("/{{ uri }}/{${{ variable }}->id}"))->assertForbidden();
    $this->get({{ url }}("/{{ uri }}/{${{ variable }}->id}/edit"))->assertForbidden();
    $this->put({{ url }}("/{{ uri }}/{${{ variable }}->id}"), {{ variable }}FormInput())->assertForbidden();
    $this->delete({{ url }}("/{{ uri }}/{${{ variable }}->id}"))->assertForbidden();
});

it('hides which {{ uri }} exist from guests', function (): void {
    $this->get({{ url }}('/{{ uri }}/999999'))->assertForbidden();
    $this->actingAs($this->user)->get({{ url }}('/{{ uri }}/999999'))->assertNotFound();
});

it('lists {{ uri }}', function (): void {
    ${{ variable }} = {{ entity }}::factory()->create();

    $this->actingAs($this->user)->get({{ url }}('/{{ uri }}'))->assertOk()->assertSee("/{{ uri }}/{${{ variable }}->id}");
});

it('shows the create form', function (): void {
    $this->actingAs($this->user)->get({{ url }}('/{{ uri }}/create'))->assertOk()->assertSee('name="_token"', false);
});

it('creates a {{ variable }}', function (): void {
    $this->actingAs($this->user)->post({{ url }}('/{{ uri }}'), {{ variable }}FormInput())
        ->assertSessionHasNoErrors()
        ->assertRedirectContains('/{{ uri }}/');

    expect({{ entity }}::count())->toBe(1);
});
