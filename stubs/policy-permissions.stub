/**
 * Each ability needs a named permission ({{ uri }}.view, .create, .update, .delete). Grant them to roles in
 * {{ definitions }}::roles() and run {{ sync }}. Guests are always denied: every method requires a User.
 */
final class {{ entity }}Policy
{
    private const GROUP = '{{ uri }}';

    public function viewAny(User $user): bool
    {
        return $user->checkPermissionTo(self::GROUP.'.view');
    }

    public function view(User $user, {{ entity }} ${{ variable }}): bool
    {
        return $user->checkPermissionTo(self::GROUP.'.view');
    }

    public function create(User $user): bool
    {
        return $user->checkPermissionTo(self::GROUP.'.create');
    }

    public function update(User $user, {{ entity }} ${{ variable }}): bool
    {
        return $user->checkPermissionTo(self::GROUP.'.update');
    }

    public function delete(User $user, {{ entity }} ${{ variable }}): bool
    {
        return $user->checkPermissionTo(self::GROUP.'.delete');
    }
}
