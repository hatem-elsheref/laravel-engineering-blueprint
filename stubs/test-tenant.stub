beforeEach(function (): void {
    // A real tenant (database + tenant migrations); users live in the tenant database.
    $this->tenant = $this->createTestTenant();
    $this->user = User::factory()->create();
{{ apiSanctumSetup }}{{ featureSetup }}{{ permissionSetup }}});

it('denies guests', function (): void {
    ${{ variable }} = {{ entity }}::factory()->create();

    $this->getJson($this->tenantUrl('/api/{{ uri }}'))->assertForbidden();
    $this->postJson($this->tenantUrl('/api/{{ uri }}'), {{ entity }}::factory()->raw())->assertForbidden();
    $this->getJson($this->tenantUrl("/api/{{ uri }}/{${{ variable }}->id}"))->assertForbidden();
    $this->putJson($this->tenantUrl("/api/{{ uri }}/{${{ variable }}->id}"), {{ entity }}::factory()->raw())->assertForbidden();
    $this->deleteJson($this->tenantUrl("/api/{{ uri }}/{${{ variable }}->id}"))->assertForbidden();
});

it('hides which {{ uri }} exist from guests', function (): void {
    $this->getJson($this->tenantUrl('/api/{{ uri }}/999999'))->assertForbidden();
    $this->actAsApiUser($this->user)->getJson($this->tenantUrl('/api/{{ uri }}/999999'))->assertNotFound();
});

it('is not served on the central domain', function (): void {
    $this->actAsApiUser($this->user)->getJson(url('/api/{{ uri }}'))->assertNotFound();
});

it('lists {{ uri }}', function (): void {
    {{ entity }}::factory(){{ factoryOwner }}->create();

    $this->actAsApiUser($this->user)->getJson($this->tenantUrl('/api/{{ uri }}'))->assertOk()->assertJsonCount(1, 'data');
});

it('creates a {{ variable }}', function (): void {
    $this->actAsApiUser($this->user)->postJson($this->tenantUrl('/api/{{ uri }}'), {{ entity }}::factory()->raw())->assertCreated();

    expect({{ entity }}::count())->toBe(1);
});
{{ validation }}
it('shows a {{ variable }}', function (): void {
    ${{ variable }} = {{ entity }}::factory(){{ factoryOwner }}->create();

    $this->actAsApiUser($this->user)->getJson($this->tenantUrl("/api/{{ uri }}/{${{ variable }}->id}"))
        ->assertOk()
        ->assertJsonPath('data.id', ${{ variable }}->id);
});

it('updates a {{ variable }}', function (): void {
    ${{ variable }} = {{ entity }}::factory(){{ factoryOwner }}->create();

    $this->travel(1)->minutes();

    $this->actAsApiUser($this->user)->putJson($this->tenantUrl("/api/{{ uri }}/{${{ variable }}->id}"), {{ entity }}::factory()->raw())->assertOk();

    expect(${{ variable }}->fresh()->updated_at->gt(${{ variable }}->updated_at))->toBeTrue();
});

it('deletes a {{ variable }}', function (): void {
    ${{ variable }} = {{ entity }}::factory(){{ factoryOwner }}->create();

    $this->actAsApiUser($this->user)->deleteJson($this->tenantUrl("/api/{{ uri }}/{${{ variable }}->id}"))->assertNoContent();

    expect({{ entity }}::count())->toBe(0);
});
