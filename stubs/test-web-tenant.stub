uses(InteractsWithTenancy::class, DatabaseMigrations::class);

beforeEach(function (): void {
    // A real tenant (database + tenant migrations); users live in the tenant database.
    $this->tenant = $this->createTestTenant();
    $this->user = User::factory()->create();
{{ featureSetup }}});

function {{ formInput }}(array $overrides = []): array
{
    // Factory values as a browser form would send them.
    return array_map(
        fn ($value) => $value instanceof DateTimeInterface ? $value->format('Y-m-d\TH:i') : (is_bool($value) ? (int) $value : $value),
        array_merge({{ entity }}::factory()->raw(), $overrides),
    );
}

it('denies guests', function (): void {
    ${{ variable }} = {{ entity }}::factory()->create();

    $this->get({{ url }}('/{{ uri }}'))->assertForbidden();
    $this->get({{ url }}('/{{ uri }}/create'))->assertForbidden();
    $this->post({{ url }}('/{{ uri }}'), {{ formInput }}())->assertForbidden();
    $this->get({{ url }}("/{{ uri }}/{${{ variable }}->id}"))->assertForbidden();
    $this->get({{ url }}("/{{ uri }}/{${{ variable }}->id}/edit"))->assertForbidden();
    $this->put({{ url }}("/{{ uri }}/{${{ variable }}->id}"), {{ formInput }}())->assertForbidden();
    $this->delete({{ url }}("/{{ uri }}/{${{ variable }}->id}"))->assertForbidden();
});

it('hides which {{ uri }} exist from guests', function (): void {
    $this->get({{ url }}('/{{ uri }}/999999'))->assertForbidden();
    $this->actingAs($this->user)->get({{ url }}('/{{ uri }}/999999'))->assertNotFound();
});

it('is not served on the central domain', function (): void {
    $this->actingAs($this->user)->get(url('/{{ uri }}'))->assertNotFound();
});

it('lists {{ uri }}', function (): void {
    ${{ variable }} = {{ entity }}::factory()->create();

    $this->actingAs($this->user)->get({{ url }}('/{{ uri }}'))->assertOk()->assertSee("/{{ uri }}/{${{ variable }}->id}");
});

it('shows the create form', function (): void {
    $this->actingAs($this->user)->get({{ url }}('/{{ uri }}/create'))->assertOk()->assertSee('name="_token"', false);
});

it('creates a {{ variable }}', function (): void {
    $this->actingAs($this->user)->post({{ url }}('/{{ uri }}'), {{ formInput }}())
        ->assertSessionHasNoErrors()
        ->assertRedirectContains('/{{ uri }}/');

    expect({{ entity }}::count())->toBe(1);
});
{{ validation }}
it('shows and edits a {{ variable }}', function (): void {
    ${{ variable }} = {{ entity }}::factory()->create();

    $this->actingAs($this->user)->get({{ url }}("/{{ uri }}/{${{ variable }}->id}"))->assertOk();
    $this->actingAs($this->user)->get({{ url }}("/{{ uri }}/{${{ variable }}->id}/edit"))->assertOk();
});

it('updates a {{ variable }}', function (): void {
    ${{ variable }} = {{ entity }}::factory()->create();

    $this->travel(1)->minutes();

    $this->actingAs($this->user)->put({{ url }}("/{{ uri }}/{${{ variable }}->id}"), {{ formInput }}())
        ->assertSessionHasNoErrors()
        ->assertRedirectContains("/{{ uri }}/{${{ variable }}->id}");

    expect(${{ variable }}->fresh()->updated_at->gt(${{ variable }}->updated_at))->toBeTrue();
});

it('deletes a {{ variable }}', function (): void {
    ${{ variable }} = {{ entity }}::factory()->create();

    $this->actingAs($this->user)->delete({{ url }}("/{{ uri }}/{${{ variable }}->id}"))->assertRedirectContains('/{{ uri }}');

    expect({{ entity }}::count())->toBe(0);
});
