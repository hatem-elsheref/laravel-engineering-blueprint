<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Tenancy">
            <directory>tests/Tenancy</directory>
        </testsuite>
        <testsuite name="Permissions">
            <directory>tests/Permissions</directory>
        </testsuite>
        <testsuite name="PermissionsTenancy">
            <directory>tests/PermissionsTenancy</directory>
        </testsuite>
        <testsuite name="MysqlIntegration">
            <directory>tests/MysqlIntegration</directory>
            <exclude>tests/MysqlIntegration/MysqlEnvironment.php</exclude>
            <exclude>tests/MysqlIntegration/MysqlTestCase.php</exclude>
            <exclude>tests/MysqlIntegration/MysqlTenancyTestCase.php</exclude>
            <exclude>tests/MysqlIntegration/MysqlSpatieTestCase.php</exclude>
            <exclude>tests/MysqlIntegration/MysqlSpatieTenancyTestCase.php</exclude>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
