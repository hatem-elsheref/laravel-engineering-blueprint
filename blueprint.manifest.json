{
  "name": "laravel-engineering-blueprint",
  "version": "0.9.0",
  "phase": {
    "current": 9,
    "name": "Starter app generator (bin/new-app) + interface translations",
    "specs": [
      "docs/PHASE-0.md",
      "docs/ARCHITECTURE.md",
      "docs/NAMING.md",
      "docs/TENANCY.md",
      "docs/FEATURES.md",
      "docs/SETTINGS.md"
    ]
  },
  "description": "Laravel 12/13 package (profiles, modules, DTOs, actions, API and Blade CRUD, multi-tenancy, features and settings) plus a portable agent kit.",
  "kitRoot": "kit",
  "docsRoot": "docs",
  "stubsRoot": "stubs",
  "skills": [
    {
      "id": "laravel-engineering",
      "path": "kit/skills/laravel-engineering",
      "name": "laravel-engineering"
    },
    {
      "id": "leb-generate-crud",
      "path": "kit/skills/leb-generate-crud",
      "name": "leb-generate-crud"
    }
  ],
  "rules": {
    "cursor": "kit/rules/cursor",
    "agentsMd": "kit/rules/templates/AGENTS.md",
    "claudeMd": "kit/rules/templates/CLAUDE.md",
    "geminiMd": "kit/rules/templates/GEMINI.md"
  },
  "install": {
    "projectBundleDir": "laravel-engineering-blueprint",
    "defaultComponents": [
      "docs",
      "skills",
      "rules",
      "stubs"
    ],
    "skillLinkTargets": {
      "cursorProject": ".cursor/skills",
      "cursorGlobal": "~/.cursor/skills",
      "agentsGlobal": "~/.agents/skills",
      "claudeGlobal": "~/.claude/skills"
    }
  },
  "future": {
    "pluginTargets": [
      "cursor",
      "codex",
      "claude-marketplace"
    ]
  },
  "package": {
    "name": "best/laravel-engineering-blueprint",
    "commands": [
      "engineering:about",
      "engineering:install",
      "make:module",
      "make:dto",
      "make:action",
      "make:crud",
      "tenant:create",
      "feature:list",
      "feature:enable",
      "feature:disable",
      "features:sync",
      "setting:list",
      "setting:set"
    ]
  }
}
