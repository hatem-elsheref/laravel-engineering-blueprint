{
    "name": "best/laravel-engineering-blueprint",
    "description": "Laravel Engineering Blueprint: modular monolith, tenancy, features and CRUD generators for Laravel.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.14",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "stancl/tenancy": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "Best\\Blueprint\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Best\\Blueprint\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Best\\Blueprint\\BlueprintServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G",
        "format": "pint",
        "check": [
            "pint --test",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "stancl/tenancy": "Required for the tenant-saas profile (^3.10)."
    }
}
