{
    "name": "best/laravel-engineering-blueprint",
    "description": "Laravel engineering blueprint: profiles, modular monolith, API and Blade CRUD generators, multi-tenancy (stancl/tenancy), features, settings and interface translations.",
    "keywords": [
        "laravel",
        "generator",
        "crud",
        "modular-monolith",
        "multi-tenancy",
        "tenancy",
        "feature-flags",
        "settings",
        "blade",
        "api",
        "i18n"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Hatem Mohamed"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.14",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "spatie/laravel-permission": "^8.0",
        "stancl/tenancy": "^3.10"
    },
    "suggest": {
        "spatie/laravel-permission": "Required for roles and permissions (^8.0).",
        "stancl/tenancy": "Required for the tenant-saas profile (^3.10)."
    },
    "autoload": {
        "psr-4": {
            "Best\\Blueprint\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Best\\Blueprint\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Best\\Blueprint\\BlueprintServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G",
        "format": "pint",
        "check": [
            "pint --test",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
