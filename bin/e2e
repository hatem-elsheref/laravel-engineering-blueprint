#!/usr/bin/env bash
# End-to-end check: build fresh Laravel apps for each profile, install this package from the local
# path, generate code with its commands, migrate, run the generated tests and cache routes.
#
#   bin/e2e                         all profiles, latest Laravel
#   bin/e2e --profile=saas          one profile (comma-separated list allowed)
#   bin/e2e --laravel=^12.0         a specific Laravel version
#   bin/e2e --keep                  keep the apps (printed at the end) for inspection
set -uo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PROFILES="basic,modular,saas,tenant-saas"
LARAVEL="^13.0"
KEEP=0

for arg in "$@"; do
  case "$arg" in
    --profile=*) PROFILES="${arg#*=}" ;;
    --laravel=*) LARAVEL="${arg#*=}" ;;
    --keep) KEEP=1 ;;
    -h|--help) sed -n '2,9p' "$0"; exit 0 ;;
    *) echo "e2e: unknown option $arg" >&2; exit 2 ;;
  esac
done

WORK="$(mktemp -d "${TMPDIR:-/tmp}/leb-e2e.XXXXXX")"
LOG="$WORK/e2e.log"
declare -a RESULTS=()
FAILED=0

log() { printf 'e2e: %s\n' "$*"; }

# Runs a command inside the app; on failure prints the tail of its output.
run() {
  local app="$1"; shift
  if ! (cd "$app" && "$@") >>"$LOG" 2>&1; then
    log "  ✗ $*"
    tail -n 30 "$LOG" | sed 's/^/      /'
    return 1
  fi
  log "  ✓ $*"
}

new_app() {
  local app="$1" tenancy="$2"
  run "$WORK" composer create-project "laravel/laravel:$LARAVEL" "$app" --prefer-dist --no-interaction -q || return 1
  run "$app" composer config repositories.blueprint path "$REPO" || return 1
  run "$app" composer config minimum-stability dev || return 1
  run "$app" composer config prefer-stable true || return 1
  run "$app" composer require "best/laravel-engineering-blueprint:*" -W --no-interaction -q || return 1
  run "$app" composer require "spatie/laravel-permission:^8.0" -W --no-interaction -q || return 1
  run "$app" composer remove phpunit/phpunit --dev --no-interaction -q || return 1
  run "$app" composer require pestphp/pest --dev -W --no-interaction -q || return 1
  (cd "$app" && ./vendor/bin/pest --init --no-interaction </dev/null >/dev/null 2>&1) || true
  if [[ "$tenancy" == 1 ]]; then
    run "$app" composer require "stancl/tenancy:^3.10" -W --no-interaction -q || return 1
    # Tenant cache isolation needs a taggable store (see the install output).
    sed -i.bak 's/^CACHE_STORE=.*/CACHE_STORE=array/' "$app/.env" && rm -f "$app/.env.bak"
  fi
}

check_routes() {
  local app="$1"
  run "$app" php artisan route:cache || return 1
  run "$app" php artisan route:clear || return 1
}

FIELDS='name:string,price:?float,active:bool,tags:array,releasedAt:?Carbon\CarbonImmutable'

profile_basic() {
  local app="$1"
  new_app "$app" 0 || return 1
  run "$app" php artisan engineering:install --profile=basic --permissions -n || return 1
  run "$app" php artisan migrate --force || return 1
  run "$app" php artisan permissions:sync || return 1
  run "$app" php artisan test || return 1
  check_routes "$app"
}

profile_modular() {
  local app="$1"
  new_app "$app" 0 || return 1
  run "$app" php artisan engineering:install --profile=modular --permissions -n || return 1
  run "$app" php artisan make:module Shop --api --web || return 1
  run "$app" php artisan make:crud Shop Product --api --web --permissions --owned "--fields=$FIELDS" || return 1
  run "$app" php artisan make:dto Shop ProductSummary --fields=name:string || return 1
  run "$app" php artisan make:action Shop PublishProduct --transaction || return 1
  run "$app" php artisan migrate --force || return 1
  run "$app" php artisan permissions:sync || return 1
  run "$app" php artisan test || return 1
  check_routes "$app"
}

profile_saas() {
  local app="$1"
  new_app "$app" 0 || return 1
  run "$app" php artisan engineering:install --profile=saas --permissions -n || return 1
  run "$app" php artisan migrate --force || return 1
  run "$app" php artisan features:sync || return 1
  run "$app" php artisan make:module Shop --api --web || return 1
  run "$app" php artisan make:crud Shop Product --api --web --feature=orders --permissions --owned "--fields=$FIELDS" || return 1
  run "$app" php artisan migrate --force || return 1
  run "$app" php artisan permissions:sync || return 1
  run "$app" php artisan feature:disable orders || return 1
  run "$app" php artisan feature:enable orders || return 1
  run "$app" php artisan setting:set orders.auto_confirm true || return 1
  run "$app" php artisan test || return 1
  check_routes "$app"
}

profile_tenant_saas() {
  local app="$1"
  new_app "$app" 1 || return 1
  run "$app" php artisan engineering:install --profile=tenant-saas -n || return 1
  run "$app" php artisan migrate --force || return 1
  run "$app" php artisan tenant:create acme || return 1
  # Permissions added to an app that already has a tenant: the sync refuses until the tenant is migrated.
  run "$app" php artisan engineering:install --profile=tenant-saas --permissions -n || return 1
  if (cd "$app" && php artisan permissions:sync) >>"$LOG" 2>&1; then
    log "  ✗ permissions:sync should refuse a tenant without permission tables"; return 1
  fi
  log "  ✓ permissions:sync refuses a tenant without permission tables"
  run "$app" php artisan migrate --force || return 1
  run "$app" php artisan tenants:migrate || return 1
  run "$app" php artisan permissions:sync || return 1
  run "$app" php artisan permissions:sync --central || return 1
  run "$app" php artisan tenant:create globex || return 1
  run "$app" php artisan tenant:create globex || return 1 # retry-safe: everything "already done"
  run "$app" php artisan make:module Shop --api --web || return 1
  run "$app" php artisan make:crud Shop Product --api --web --feature=orders --permissions --owned "--fields=$FIELDS" || return 1
  run "$app" php artisan make:module Admin --api --web --central || return 1
  run "$app" php artisan make:crud Admin Plan --api --web --permissions --fields=title:string || return 1
  run "$app" php artisan migrate --force || return 1
  run "$app" php artisan tenants:migrate || return 1
  run "$app" php artisan permissions:sync || return 1
  run "$app" php artisan permissions:sync --central || return 1
  run "$app" php artisan feature:enable orders --tenant=acme || return 1
  run "$app" php artisan test || return 1
  check_routes "$app"
}

IFS=',' read -r -a SELECTED <<<"$PROFILES"
for profile in "${SELECTED[@]}"; do
  fn="profile_${profile//-/_}"
  if ! declare -F "$fn" >/dev/null; then
    log "unknown profile $profile"; FAILED=1; continue
  fi
  log "── $profile (laravel/laravel $LARAVEL)"
  if "$fn" "$WORK/$profile"; then
    RESULTS+=("✓ $profile")
  else
    RESULTS+=("✗ $profile"); FAILED=1
  fi
done

log "── results"
for line in "${RESULTS[@]}"; do log "  $line"; done
log "log: $LOG"

if [[ "$KEEP" == 1 ]]; then
  log "apps kept in $WORK"
else
  rm -rf "$WORK"
fi

exit "$FAILED"
